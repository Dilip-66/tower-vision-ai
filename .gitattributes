# Normalize line endings for all text files
* text=auto

*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.csv  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Windows scripts keep CRLF
*.ps1  text eol=crlf
*.bat  text eol=crlf

# Binary files - never touched
*.png  binary
*.jpg  binary
*.jpeg binary
*.pt   binary
*.onnx binary
